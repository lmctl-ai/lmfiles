# Snapshot isolation: ten items are captured, then five more are added.
mkdir(".lmfiles-local"); mkdir(".lmfiles-local/snapshots"); mkdir("images"); mkdir("build");
if (file_exists(".lmfiles-local/snapshots/state.mv")) { remove_file(".lmfiles-local/snapshots/state.mv"); }
let state = _lmcode_ cli="lmfiles" install="github:lmctl-ai/lmfiles@latest";
let db = registry.open(".lmfiles-local/snapshots/state.mv", "snapshots", "{}");
for (i in range(0, 10)) { db.item_upsert("{\"id\":\"archive-" + str(i) + "\"}", "{\"source\":\"synthetic\"}"); }
let snap = db.snapshot();
for (i in range(10, 15)) { db.item_upsert("{\"id\":\"archive-" + str(i) + "\"}", "{\"source\":\"synthetic\"}"); }
let old = snap.query("{\"all\":true}", "{}");
let oldrows = old.rows(100, 1048576);
let current_snap = db.snapshot();
let current = current_snap.query("{\"all\":true}", "{}");
let currentrows = current.rows(100, 1048576);
file_write(".lmfiles-local/snapshots/data.dat", "snapshot " + str(oldrows.len()) + "\ncurrent " + str(currentrows.len()) + "\n");
old.close(); current.close(); current_snap.close(); snap.close(); db.close();
end _lmcode_
savedsl(state, "build/snapshots-state.dslb");
let run = system ${dsl_cli(state)} --dsl build/snapshots-state.dslb;
assert(run.code == 0);

assert(read_file(".lmfiles-local/snapshots/data.dat")=="snapshot 10\ncurrent 15\n");
let plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/snapshots.png", 820, 520);
plot.cmd("set title 'Snapshot versus current registry'; set ylabel 'items'; set style data histograms; set style fill solid 0.8; set datafile separator ' '; set yrange [0:*]; plot '.lmfiles-local/snapshots/data.dat' using 2:xtic(1) title 'registry count'");
plot.close();
end _lmcode_
savedsl(plot, "build/snapshots-plot.dslb");
let plotted = system ${dsl_cli(plot)} --dsl build/snapshots-plot.dslb;
assert(plotted.code == 0);
